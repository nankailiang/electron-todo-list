{
  "name": "zhixing",
  "version": "1.0.0",
  "description": "知行 —— 任务、日报与效率看板一体的桌面工作台（Electron）",
  "main": "main.js",
  "scripts": {
    "start": "node electron-launch.js",
    "dev": "node electron-launch.js --dev",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "set \"ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/\" && electron-builder --win",
    "dist:mac": "set \"ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/\" && electron-builder --mac",
    "dist:linux": "set \"ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/\" && electron-builder --linux",
    "dist:win:quick": "electron-builder --win --publish never",
    "sync-ui": "node tauri-zhixing/scripts/sync-ui.mjs",
    "sync-ui:check": "node tauri-zhixing/scripts/sync-ui.mjs --check",
    "tauri:dev": "npm --prefix tauri-zhixing run dev",
    "tauri:build": "npm --prefix tauri-zhixing run build",
    "tauri:portable": "npm --prefix tauri-zhixing run build:portable"
  },
  "keywords": ["electron", "todo", "daily-report", "kanban", "desktop", "zhixing"],
  "author": "Zhixing",
  "license": "MIT",
  "devDependencies": {
    "electron": "^39.2.3",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.zhixing.app",
    "productName": "知行",
    "copyright": "Copyright © 2026 Zhixing",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "app.js",
      "index.html",
      "styles.css",
      "package.json",
      "assets/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64", "ia32"]
        },
        {
          "target": "portable",
          "arch": ["x64", "ia32"]
        }
      ],
      "legalTrademarks": "知行",
      "requestedExecutionLevel": "asInvoker",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "知行",
      "uninstallDisplayName": "知行",
      "deleteAppDataOnUninstall": false,
      "allowElevation": true,
      "installerLanguages": ["zh_CN"],
      "language": "2052"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Utility",
      "icon": "assets/icon.png"
    },
    "npmRebuild": false,
    "publish": {
      "provider": "generic",
      "url": "https://example.com/releases/"
    }
  }
}